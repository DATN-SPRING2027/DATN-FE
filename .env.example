# Server-only backend URL. For microservices, point this at the API Gateway
# (for example http://api-gateway:3000 from the same Docker network).
# The local default below targets the shared backend started with npm start.
CONTINUUM_API_BASE_URL=http://localhost:3001

# Set to 1 in production when a trusted edge proxy appends the real client IP to X-Forwarded-For.
# Set to 2-5 only for a known chain of that many trusted edge hops. Keep FE private
# behind those proxies; direct access with a forged X-Forwarded-For must be blocked.
# The Gateway must trust only this BFF's peer CIDR via GATEWAY_TRUSTED_PROXY_CIDRS.
CONTINUUM_TRUSTED_EDGE_HOPS=0

# Public application metadata. Never expose secrets with NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=Continuum AI
