# Server-only backend URL. For microservices, point this at the API Gateway
# (for example http://api-gateway:3000 from the same Docker network).
# The local default below targets the shared backend started with npm start.
CONTINUUM_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:3005/internal/chat/ws

# Set to 1 in production when a trusted edge proxy appends the real client IP to X-Forwarded-For.
# Set to 2-5 only for a known chain of that many trusted edge hops. Keep FE private
# behind those proxies; direct access with a forged X-Forwarded-For must be blocked.
# The Gateway must trust only this BFF's peer CIDR via GATEWAY_TRUSTED_PROXY_CIDRS.
CONTINUUM_TRUSTED_EDGE_HOPS=0

# Public application metadata. Never expose secrets with NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=Continuum AI

# Development integration only. Production remains blocked even if set true.
# Backend/Gateway must independently provide their reviewed Team development setup.
TEAM_FOUNDATION_DEV_INTEGRATION=false

# Optional OpenTelemetry export. Leave blank to disable tracing.
# Local Node.js process: http://localhost:4318; Docker Compose: http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=continuum-fe-bff
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# Enable only alongside the reviewed Capture DB/API rollout.
NEXT_PUBLIC_WORKNOTE_EDITOR_ENABLED=false
NEXT_PUBLIC_WORKNOTE_SHARED_EDITOR_ENABLED=false
NEXT_PUBLIC_WORKNOTE_ASSESSMENT_ENABLED=false
