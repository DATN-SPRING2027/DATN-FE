# Server-only backend URL. For microservices, point this at the API Gateway
# (for example http://api-gateway:3000 from the same Docker network).
# The local default below targets the shared backend started with npm start.
CONTINUUM_API_BASE_URL=http://localhost:3001

# Public application metadata. Never expose secrets with NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=Continuum AI
